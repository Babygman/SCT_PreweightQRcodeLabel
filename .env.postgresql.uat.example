# Use only with compose.postgresql.uat.yaml on the approved UAT Docker host.
# Copy to .env.postgresql.uat, replace every placeholder locally, and keep mode 0600.
APP_ENV=uat
SECRET_KEY=<GENERATE_A_LONG_RANDOM_SECRET>
POSTGRES_DB=sct_preweight_uat
POSTGRES_USER=sct_preweight_uat_app
POSTGRES_PASSWORD=<GENERATE_A_LONG_RANDOM_DATABASE_PASSWORD>
# URL-encode reserved characters in POSTGRES_USER and POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://sct_preweight_uat_app:<URL_ENCODED_PASSWORD>@sct-preweight-postgresql-uat:5432/sct_preweight_uat
APP_TIMEZONE=Asia/Bangkok
MATERIAL_TAG_ISSUANCE_ENABLED=1
FINISHED_GOODS_MASTER_ENABLED=1
