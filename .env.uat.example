# Copy to .env.uat on the Docker host and replace every placeholder locally.
APP_ENV=uat
SECRET_KEY=<GENERATE_A_LONG_RANDOM_SECRET>
# URL-encode reserved characters in the username and password before inserting them.
DATABASE_URL=mssql+pyodbc://<URL_ENCODED_USERNAME>:<URL_ENCODED_PASSWORD>@10.206.1.94:1433/SCT_Preweight_UAT?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
APP_TIMEZONE=Asia/Bangkok
MATERIAL_TAG_ISSUANCE_ENABLED=1
FINISHED_GOODS_MASTER_ENABLED=1
